<style>
  #groq-badge {
    position: fixed;
    bottom: 18px;
    right: 18px;
    z-index: 9999;
    line-height: 0;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.15);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  #groq-badge:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.22);
  }
  #groq-badge img {
    display: block;
    height: 32px;
    width: auto;
  }
  #groq-badge .badge-dark { display: none; }
  @media (prefers-color-scheme: dark) {
    #groq-badge .badge-light { display: none; }
    #groq-badge .badge-dark  { display: block; }
  }
</style>

<a id="groq-badge" href="https://groq.com" target="_blank" rel="noopener noreferrer">
  <img class="badge-light"
       src="https://console.groq.com/powered-by-groq-light.svg"
       alt="Powered by Groq for fast inference." />
  <img class="badge-dark"
       src="https://console.groq.com/powered-by-groq-dark.svg"
       alt="Powered by Groq for fast inference." />
</a>

